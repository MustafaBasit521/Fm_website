# Copy to .env (never commit .env).
APP_ENV=development
# Local dev DB from docker-compose.yml. For Supabase, use its connection string
# with the postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://crochet:crochet_dev_password@localhost:5433/crochet
# Public project URL. JWTs are verified with the project's public signing key (JWKS):
# no Supabase secret is needed or stored by the backend.
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVER-ONLY secret for Storage signed uploads/deletes. Leave empty to disable image upload.
SUPABASE_SERVICE_KEY=
PRODUCT_IMAGES_BUCKET=product-images
# Keep false until a payment gateway is integrated. "fake" is a dev-only simulator
# (refused when APP_ENV=production); with it you can set ONLINE_PAYMENTS_ENABLED=true locally.
ONLINE_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=none
# SERVER-ONLY: verifies webhook signatures. Use a long random value.
PAYMENT_WEBHOOK_SECRET=
# Where customers return after paying (the storefront URL).
FRONTEND_URL=http://localhost:5173
# Storage buckets (create them in Supabase; the custom-order bucket must be PRIVATE).
GALLERY_IMAGES_BUCKET=gallery-images
CUSTOM_ORDER_REFERENCES_BUCKET=custom-order-references
# "none" sends nothing; "console" logs emails (development only); "resend" sends through Resend.
EMAIL_PROVIDER=none
# For "resend" (server-only secret, never commit it) and the sender customers see, e.g.
# Bundle of Loops <hello@yourdomain.com>. Until your domain is verified in Resend, only
# onboarding@resend.dev works, and only to your own Resend account address (testing).
RESEND_API_KEY=
EMAIL_FROM=
# For "smtp" (e.g. a dedicated Gmail with 2-Step Verification and an App Password; EMAIL_FROM must
# be that Gmail address): smtp.gmail.com, port 465, the Gmail address, the 16-letter App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Secret for the scheduled expiry route: POST /api/internal/expire-orders with the header
# X-Cron-Secret. Leave empty to switch the route off. Use a long random value (server-only).
CRON_SECRET=
# Set true only when the API runs behind a trusted reverse proxy (used for rate limiting).
TRUST_PROXY_HEADERS=false
# Admin logins must complete a second factor (authenticator app). Keep true; you may set false
# for local development only (the app refuses false when APP_ENV=production).
ADMIN_REQUIRE_MFA=true
# Requests per client per minute for the whole API (0 = off), and the log level.
# NOTE: behind a reverse proxy (Vercel, nginx...) also set TRUST_PROXY_HEADERS=true, otherwise every
# visitor looks like the proxy's address and shares ONE rate-limit budget.
GLOBAL_RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
