# Copy to .env. Only VITE_-prefixed values reach the browser: NEVER put secrets here.
# Leave empty in dev to use the Vite proxy (/api -> http://localhost:8000).
VITE_API_BASE_URL=
# Public values (safe in the browser). NEVER put the service-role key or any secret here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
